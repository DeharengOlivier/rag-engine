# Copy this file to .env and fill in values as needed.
# The engine runs fully offline with the defaults below: no API key required.

# Optional API keys (only needed if you switch RAG_LLM_PROVIDER below).
# Leave blank to run offline with the extractive provider.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Embedder: "hashing" (offline, no deps) or "sentence-transformers" (optional).
RAG_EMBEDDER=hashing

# LLM provider: "extractive" (offline), "anthropic", or "openai".
RAG_LLM_PROVIDER=extractive

# Number of chunks to retrieve per query.
RAG_TOP_K=4

# Optional tuning (defaults shown).
# RAG_EMBEDDING_DIM=256
# RAG_CHUNK_SIZE=600
# RAG_CHUNK_OVERLAP=100
# RAG_SIMILARITY_THRESHOLD=0.15
# RAG_INDEX_DIR=.rag_index
# RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
# RAG_LLM_MODEL=claude-opus-4-8
